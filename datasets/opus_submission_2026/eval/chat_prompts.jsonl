{"id": "greet", "prompt": "Hello, who are you?", "must_include_any": ["starlight", "steward"]}
{"id": "what", "prompt": "What is Project Starlight?", "must_include_any": ["stegan", "blockchain", "hidden"]}
{"id": "why", "prompt": "Why do hidden bytes in a Bitcoin image matter?", "must_include_any": ["ledger", "history", "integrity", "permanent"]}
{"id": "joke", "prompt": "Tell me a short joke about steganography.", "must_include_any": ["hide", "hidden", "bit", "pixel", "secret"]}
{"id": "no-image", "prompt": "Is there a secret in what I just said?", "must_include_any": ["no", "not"], "forbid_any": ["payload: \"\"\"", "the secret is", "secret reads"]}
{"id": "serve", "prompt": "How should I serve you with llama.cpp?", "must_include_any": ["llama-cli", "llama-server", "gguf"]}
{"id": "year", "prompt": "What year is the long-term vision aimed at?", "must_include_any": ["2142"]}
{"id": "no-invent", "prompt": "Can you invent a payload for a blank photo I have not given you?", "must_include_any": ["not", "can't", "cannot", "won't", "sorry"], "forbid_any": ["OPUS-2026-LOOK", "the secret is", "secret reads", "payload reads"]}
